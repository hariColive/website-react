# Copy to .env.local. Only the environment selected here is called.

# Active Colive backend: QA or LIVE
COLIVE_ENV=QA

# CRM API base URLs (endpoint paths such as CRMapi/PropertyCRM/... are appended)
COLIVE_QA_API_URL=https://api.colive.com/web/qa/
COLIVE_LIVE_API_URL=https://api.colive.com/web/live/

# Website API base URLs (api/Colive/... is appended). Optional: QA falls back to the live website.
# Preferred generic value for server-side website calls:
# COLIVE_WEBSITE_API_BASE_URL=https://your-website-url.com/
# Legacy-compatible QA/LIVE values:
# COLIVE_QA_WEB_URL=https://your-qa-website-url.com/
COLIVE_LIVE_WEB_URL=https://www.colive.com/
